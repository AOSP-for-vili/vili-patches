diff --git a/interface/jni/SdkFrameProvider.h b/interface/jni/SdkFrameProvider.h
--- a/interface/jni/SdkFrameProvider.h	(revision c5b6159d081ed2e417974388d8f98a58d6b57656)
+++ b/interface/jni/SdkFrameProvider.h	(revision 2faf9dd3f3c6c9cfac2438ca8fc37cf98b4bb213)
@@ -53,6 +53,7 @@
             mBufferIdToAHardwareBuffer;  // guarded by mMapLock
     uint32_t mNextBufferId = 0;          // guarded by mMapLock
     std::shared_ptr<Encoder> mEncoder;
+    bool mGpuDisabled = false;
 };
 
 }  // namespace webcam
